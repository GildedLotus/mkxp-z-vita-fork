+#ifdef __vita__
+static int
+vita_worker_stack(size_t vm_size, VALUE **stack_start, size_t *stack_maxsize)
+{
+    rb_nativethread_id_t curr = pthread_self();
+    void *start;
+    size_t size;
+    int err = get_stack(&start, &size);
+    if (err) return err > 0 ? err : EIO;
+    if (!start || (uintptr_t)start < (uintptr_t)&curr ||
+        (uintptr_t)start - (uintptr_t)&curr >= size) return EINVAL;
+    size -= (uintptr_t)start - (uintptr_t)&curr;
+    /* gc.c reserves 2048 VALUEs below the VM stack. */
+    if (size <= vm_size || size - vm_size <= 2048 * sizeof(VALUE)) return ERANGE;
+    *stack_start = (VALUE *)&curr;
+    *stack_maxsize = size;
+    return 0;
+}
+#endif
