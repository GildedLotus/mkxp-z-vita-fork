+
+/* Cancelled records cannot be reused until their child has exited startup.
+ * Eight absent children exhaust this pool instead of leaking without bound. */
+enum { VITA_START_PENDING, VITA_START_READY, VITA_START_CANCELLED };
+struct vita_thread_startup {
+    rb_atomic_t refs, state;
+    rb_thread_t *th;
+    rb_execution_context_t *ec;
+    size_t vm_size;
+    VALUE *stack_start;
+    size_t stack_maxsize;
+    int error;
+};
+static struct vita_thread_startup vita_startups[8];
+
+static struct vita_thread_startup *
+vita_startup_acquire(rb_thread_t *th)
+{
+    for (size_t i = 0; i < numberof(vita_startups); ++i) {
+        struct vita_thread_startup *startup = &vita_startups[i];
+        if (RUBY_ATOMIC_CAS(startup->refs, 0, 2) != 0) continue;
+        startup->th = th;
+        startup->ec = th->ec;
+        startup->vm_size = th->vm->default_params.thread_vm_stack_size;
+        RUBY_ATOMIC_SET(startup->state, VITA_START_PENDING);
+        return startup;
+    }
+    return NULL;
+}
+
+static void
+vita_startup_release(struct vita_thread_startup *startup)
+{
+    RUBY_ATOMIC_FETCH_SUB(startup->refs, 1);
+}
+
+static rb_thread_t *
+vita_thread_startup(struct vita_thread_startup *startup)
+{
+    rb_thread_t *th = NULL;
+    if (RUBY_ATOMIC_CAS(startup->state, VITA_START_PENDING, VITA_START_PENDING) == VITA_START_CANCELLED)
+        goto done;
+    /* Only the record is owned here: cancellation may already have freed th. */
+    int err = vita_worker_stack(startup->vm_size, &startup->stack_start, &startup->stack_maxsize);
     if (!err && !ruby_native_tls_ready) err = EINVAL;
-    if (!err) err = pthread_setspecific(ruby_native_thread_key, th);
+    if (!err) err = pthread_setspecific(ruby_native_thread_key, startup->th);
     if (!err) {
-        err = pthread_setspecific(ruby_current_ec_key, th->ec);
+        err = pthread_setspecific(ruby_current_ec_key, startup->ec);
         if (err) {
             int cleanup = pthread_setspecific(ruby_native_thread_key, NULL);
             if (cleanup) rb_bug_errno("Ruby TLS startup cleanup", cleanup);
         }
     }
+    startup->error = err;
+    if (RUBY_ATOMIC_CAS(startup->state, VITA_START_PENDING, VITA_START_READY) != VITA_START_PENDING) {
+        if (!err) {
+            native_tls_set(ruby_current_ec_key, NULL);
+            native_tls_set(ruby_native_thread_key, NULL);
+        }
+        goto done;
+    }
+    if (err) goto done;
+    /* Winning READY commits the parent to success and keeps th alive. Wait
+     * for its stack publication using the existing interrupt pair. */
