+#ifdef __vita__
+static int
+vita_thread_startup(rb_thread_t *th)
+{
+    int err = native_thread_init_stack(th);
+    if (!err && !ruby_native_tls_ready) err = EINVAL;
+    if (!err) err = pthread_setspecific(ruby_native_thread_key, th);
+    if (!err) {
+        err = pthread_setspecific(ruby_current_ec_key, th->ec);
+        if (err) {
+            int cleanup = pthread_setspecific(ruby_native_thread_key, NULL);
+            if (cleanup) rb_bug_errno("Ruby TLS startup cleanup", cleanup);
+        }
+    }
+    rb_native_mutex_lock(&th->interrupt_lock);
+    th->native_thread_data.startup_error = err;
+    th->native_thread_data.startup_ready = 1;
+    rb_native_cond_signal(&th->native_thread_data.cond.intr);
+    rb_native_mutex_unlock(&th->interrupt_lock);
+    /* On failure the parent may now reclaim th. */
+    return err;
+}
