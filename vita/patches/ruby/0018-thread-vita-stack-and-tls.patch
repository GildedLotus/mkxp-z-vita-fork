-#ifdef HAVE_PTHREAD_GETATTR_NP /* Linux */
+#if defined(__vita__)
+    SceKernelThreadInfo info;
+    uintptr_t base;
+    memset(&info, 0, sizeof(info));
+    info.size = sizeof(info);
+    CHECK_ERR(sceKernelGetThreadInfo(sceKernelGetThreadId(), &info));
+    base = (uintptr_t)info.stack;
+    if (!base || info.stackSize <= 0 ||
+        (size_t)info.stackSize > UINTPTR_MAX - base) return EINVAL;
+    /* ARM stacks grow down: MRI expects the high end, not the base. */
+    *size = (size_t)info.stackSize;
+    *addr = (void *)(base + *size);
+#elif defined HAVE_PTHREAD_GETATTR_NP /* Linux */
     pthread_attr_t attr;
     size_t guard = 0;
     STACK_GROW_DIR_DETECTION;
@@ -947,14 +976,8 @@
