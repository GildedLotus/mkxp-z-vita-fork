Subject: [Vita] Discover registered thread stacks and use pthread-key TLS

Secondary Ruby threads must initialize on their own registered stacks,
without raising before MRI installs its exception tag. Keep MRI's 512 KiB
machine + 512 KiB VM defaults (a 1 MiB pthread stack on ARM32). The owner's
fiber arena floor still takes precedence over its full kernel stack bounds.
Use pthread keys instead of compiler TLS or shared globals. Count timedwait
attempts for the sleep diagnostic; config.site selects realtime deadlines
because pthread-embedded ignores the requested condition-variable clock.

--- a/thread_pthread.c
+++ b/thread_pthread.c
@@ -19,6 +19,7 @@
  * ruby_init_stack has to know where the thread's own stack really ends.
  * The -I is injected by vita/scripts/build-ruby-vita.sh. */
 #include <vita_fiber_arena.h>
+#include <psp2/kernel/threadmgr.h>
 #endif
 
 #ifdef HAVE_SYS_RESOURCE_H
@@ -575,6 +576,17 @@
     }
 }
 
+#ifdef __vita__
+/* Counts attempts, including immediate timeouts, across all Ruby threads. */
+static rb_atomic_t vita_timedwait_count;
+
+static VALUE
+rb_thread_s_vita_timedwait_count(VALUE klass)
+{
+    return UINT2NUM(RUBY_ATOMIC_FETCH_ADD(vita_timedwait_count, 0));
+}
+#endif
+
 static int
 native_cond_timedwait(rb_nativethread_cond_t *cond, pthread_mutex_t *mutex, const rb_hrtime_t *abs)
 {
@@ -589,6 +601,9 @@
      */
     do {
         rb_hrtime2timespec(&ts, abs);
+#ifdef __vita__
+        RUBY_ATOMIC_INC(vita_timedwait_count);
+#endif
         r = pthread_cond_timedwait(cond, mutex, &ts);
     } while (r == EINTR);
 
@@ -748,7 +763,9 @@
 static rb_thread_t *register_cached_thread_and_wait(void *);
 #endif
 
-#if defined HAVE_PTHREAD_GETATTR_NP || defined HAVE_PTHREAD_ATTR_GET_NP
+#if defined(__vita__)
+#define STACKADDR_AVAILABLE 1
+#elif defined HAVE_PTHREAD_GETATTR_NP || defined HAVE_PTHREAD_ATTR_GET_NP
 #define STACKADDR_AVAILABLE 1
 #elif defined HAVE_PTHREAD_GET_STACKADDR_NP && defined HAVE_PTHREAD_GET_STACKSIZE_NP
 #define STACKADDR_AVAILABLE 1
@@ -784,7 +801,19 @@
 {
 #define CHECK_ERR(expr)				\
