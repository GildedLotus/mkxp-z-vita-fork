 		if (needs_end_scene) {
-			scene_end();
+			if (!scene_target_missing)
+				scene_end();
 		} else {
 			if (legacy_pool_size) {
 				legacy_pool = (float *)gpu_alloc_mapped_temp(legacy_pool_size);
@@ -617,6 +619,7 @@ void scene_reset(void) {
 #endif
 
 		// Starting drawing scene
+		scene_target_missing = GL_FALSE;
 		is_rendering_display = !active_write_fb;
 		if (is_rendering_display) { // Default framebuffer is used
 			if (system_app_mode) {
@@ -654,6 +657,7 @@ void scene_reset(void) {
 #else
 				int r = setup_render_target(&active_write_fb->target, active_write_fb->width, active_write_fb->height, gxm_fbo_rt_size);
 				if (r) {
+					active_write_fb->target = NULL;
 					vgl_error = GL_OUT_OF_MEMORY;
 #ifdef LOG_ERRORS
 					vgl_log("%s:%d Failed to create a rendertarget of size %dx%d for framebuffer 0x%08X (%s).\n", __FILE__, __LINE__, active_write_fb->width, active_write_fb->height, active_write_fb, get_gxm_error_literal(r));
@@ -670,6 +674,14 @@ void scene_reset(void) {
 				}
 			}
 #endif
+			// sceGxmBeginScene crashes inside SceGxm on a NULL rendertarget: leave no scene open, callers skip the draw
+			if (!active_write_fb->target) {
+				active_write_fb->rt_failed = GL_TRUE;
+				scene_target_missing = GL_TRUE;
+				needs_scene_reset = GL_TRUE;
