# vitagl-0001: OOM error contract for texture/buffer backing allocations.
# At this pin a failed gpu_alloc_mapped_* leaves textures/buffers silently empty and
# several paths copy into NULL. On backing-allocation failure the GL entry
# points now report GL_OUT_OF_MEMORY through the existing SET_GL_ERROR
# mechanism: gpu_alloc_texture and the level-0 path of
# gpu_alloc_compressed_texture release the previous storage only after a
# successful allocation (transactional re-specification); cube/paletted/planar
# helpers mark the object cleanly unused instead; the glTexSubImage2D
# orphan-copy, POT/ETC staging buffers, glCopyTexImage2D, glBufferSubData
# orphan-copy, glNamedBufferData (stale-size reset) and _glReadPixels_gpu
# temps no longer write through NULL; FBO render-target and depth/stencil
# allocation failures set vgl_error (scene flow unchanged). The frame purge
# lists drop instead of overwrite past their slots, and the circular-pool
# fallback no longer queues a NULL entry that would stop the GC scan early.
diff --git a/source/buffers.c b/source/buffers.c
index 9ef4257..9b32f8d 100644
--- a/source/buffers.c
+++ b/source/buffers.c
@@ -425,6 +425,8 @@ inline void glNamedBufferData(GLuint buffer, GLsizei size, const void *data, GLe
 
 #ifndef SKIP_ERROR_HANDLING
 	if (!gpu_buf->ptr) {
+		// A stale size would let a later glBufferSubData write at NULL
+		gpu_buf->size = 0;
 		SET_GL_ERROR(GL_OUT_OF_MEMORY)
 	}
 #endif
@@ -482,12 +484,10 @@ inline void glNamedBufferSubData(GLuint buffer, GLintptr offset, GLsizeiptr size
 		uint8_t *ptr = gpu_buf->alloc_func(gpu_buf->size);
 #endif
 
-#ifdef LOG_ERRORS
+		// A failed orphan copy must not fall through into a NULL copy
 		if (!ptr) {
-			vgl_log("%s:%d glBufferSubData failed to alloc a buffer of %ld bytes. Buffer content won't be updated.\n", __FILE__, __LINE__, gpu_buf->size);
-			return;
+			SET_GL_ERROR(GL_OUT_OF_MEMORY)
 		}
-#endif
 
 		// Copying up previous data combined to modified data
 		if (offset > 0)
