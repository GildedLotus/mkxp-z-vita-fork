+// Loads a cached FFP program: whole file, read fully, a well-formed GXP no larger than the file. NULL when
+// the entry is missing, unreadable or short of memory; a file that fails the checks is removed so it is rebuilt.
+// This validates the header and size only (the FFP programs' parameter tables are not walked).
+static SceGxmProgram *ffp_read_cached_program(const char *fname) {
+	SceUID f = sceIoOpen(fname, SCE_O_RDONLY, 0777);
+	if (f < 0)
+		return NULL;
+	SceOff size = sceIoLseek(f, 0, SCE_SEEK_END);
+	sceIoLseek(f, 0, SCE_SEEK_SET);
+	SceGxmProgram *prog = NULL;
+	GLboolean corrupt = GL_TRUE;
+	if (size < 0) {
+		corrupt = GL_FALSE;
+	} else if (size >= 64 && size <= 4 * 1024 * 1024) {
+		prog = (SceGxmProgram *)vglMalloc((uint32_t)size);
+		if (!prog) {
+			corrupt = GL_FALSE;
+		} else {
+			SceOff got = 0;
+			int n = 1;
+			while (got < size && (n = sceIoRead(f, (uint8_t *)prog + got, (SceSize)(size - got))) > 0)
+				got += n;
+			if (n < 0)
+				corrupt = GL_FALSE;
+			else if (got == size && !sceGxmProgramCheck(prog) && sceGxmProgramGetSize(prog) <= (uint32_t)size)
+				corrupt = GL_FALSE;
+			if (corrupt || n < 0) {
+				vgl_free(prog);
+				prog = NULL;
+			}
+		}
+	}
+	sceIoClose(f);
+	if (corrupt) {
+		vgl_log("%s:%d %s: Removing invalid FFP shader cache file %s.\n", __FILE__, __LINE__, __func__, fname);
+		sceIoRemove(fname);
+	}
+	return prog;
+}
