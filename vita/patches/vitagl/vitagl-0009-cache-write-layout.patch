# vitagl-0009: shader-cache write and layout fixes from a code review.
# - custom_shaders.c: vgl_cache_write (also used by ffp.c) writes <entry>.tmp, checks open, the full write and the
#   close, renames into place and removes the .tmp on any failure, so a torn write never sits under the final
#   name (readers already reject short files, 0007). It is not an atomic replace; entries
#   are regenerable. compile_shader no longer writes through an unchecked handle, and serialize_shader returns
#   NULL on allocation failure instead of copying into NULL.
# - custom_shaders.c: glCompileShader keys its no-bindings layout as <hash>-nb.gxp; glLinkProgram keeps
#   <hash>.gxp (bindings layout), so the two layouts of one source no longer share a file. Shipped GXPs are
#   the bindings layout under <hash>.gxp: unchanged, still valid.
# - ffp.c: the fixed-function program cache reads whole files into a validated GXP (size window, full read,
#   sceGxmProgramCheck, program size <= file), removes an invalid file, and writes through vgl_cache_write.
# - shared.h: vgl_cache_write declaration.
diff --git a/source/custom_shaders.c b/source/custom_shaders.c
index 0044cd9..b81507a 100644
--- a/source/custom_shaders.c
+++ b/source/custom_shaders.c
@@ -37,6 +37,24 @@
 char vgl_shader_cache_path[256];
 char vgl_shader_cache_fallback_path[256];
 #endif
+
+// A cache entry is written to <path>.tmp and renamed into place, and only counts once every byte is
+// written; readers reject short files anyway. A stale .tmp is never read and the next write overwrites it.
+GLboolean vgl_cache_write(const char *path, const void *data, size_t size) {
+	char tmp[264];
+	if (snprintf(tmp, sizeof(tmp), "%s.tmp", path) >= (int)sizeof(tmp))
+		return GL_FALSE;
+	SceUID f = sceIoOpen(tmp, SCE_O_CREAT | SCE_O_WRONLY | SCE_O_TRUNC, 0777);
+	if (f < 0)
+		return GL_FALSE;
+	int n = sceIoWrite(f, data, size);
+	int c = sceIoClose(f);
+	if (n != (int)size || c < 0 || sceIoRename(tmp, path) < 0) {
+		sceIoRemove(tmp);
+		return GL_FALSE;
+	}
+	return GL_TRUE;
+}
 #ifdef HAVE_TEX_CACHE
 char vgl_file_cache_path[256];
 #endif
